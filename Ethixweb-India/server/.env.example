# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ethixweb?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ethixweb_india

# JWT Authentication (Never expose to client)
JWT_SECRET=ethixweb_secure_jwt_secret_key_2026_dev
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Credentials (Environment-based setup)
ADMIN_EMAIL=admin@ethixweb.com
ADMIN_PASSWORD=AdminPassword@123
ADMIN_NAME=Ethixweb Administrator

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173
