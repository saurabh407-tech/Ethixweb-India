# ==========================================
# Ethixweb India Project Environment Guide
# ==========================================

# Server Configuration (server/.env)
SERVER_PORT=5000
SERVER_NODE_ENV=development

# MongoDB Atlas or Local MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/ethixweb_india
# Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ethixweb?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=ethixweb_secure_jwt_secret_key_2026_dev
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (One-time secure initialization)
ADMIN_EMAIL=admin@ethixweb.com
ADMIN_PASSWORD=AdminPassword@123
ADMIN_NAME=Ethixweb Administrator

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Client Configuration (client/.env)
VITE_API_BASE_URL=http://localhost:5000/api
